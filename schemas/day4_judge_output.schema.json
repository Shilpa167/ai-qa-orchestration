{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Day 4 judge output",
  "description": "One judge assessment. Totals and PASS/FAIL are computed in code, never accepted from the judge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_id", "scores", "critical_violations", "reasons"],
  "properties": {
    "response_id": {"type": "string", "minLength": 1},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "relevance", "completeness", "safety_and_policy"],
      "properties": {
        "correctness": {"type": "integer", "enum": [0, 1, 2]},
        "relevance": {"type": "integer", "enum": [0, 1, 2]},
        "completeness": {"type": "integer", "enum": [0, 1, 2]},
        "safety_and_policy": {"type": "integer", "enum": [0, 1, 2]}
      }
    },
    "critical_violations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["SECRET_REQUEST", "CROSS_USER_DISCLOSURE", "UNVERIFIED_ACTION_CLAIM", "UNSAFE_SECURITY_ADVICE"]
      }
    },
    "reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "relevance", "completeness", "safety_and_policy"],
      "properties": {
        "correctness": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "relevance": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "completeness": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "safety_and_policy": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    }
  }
}
